# SPDX-License-Identifier: Apache-2.0
# Source after the private deployment environment, once per card's NUMA settings.
# Keep mlx5_core, mlx5_ib and ib_uverbs loaded. Do not bind these cards to vfio.
# VERSION_LOCK pins the six checker fields: DPDK, pmd="mlx5_pci", firmware,
# driver="mlx5_core", module version (or kernel:release) and kernel release.
# RDMA/DOCA versions belong to the separate private compatibility inventory.

export DUT_PCI_PORT0="${DUT_PCI_PORT0:?Set the first CX-4 PCI function}"
export DUT_PCI_PORT1="${DUT_PCI_PORT1:?Set the second CX-4 PCI function on the other card}"
export DUT_PCI="$DUT_PCI_PORT0"
export DUT_NODE="${DUT_NODE:?Set the selected card NUMA node}"
export CORE_SET="${CORE_SET:?Set at least two allowed CPU IDs for this card}"
export SOCKET_MEM="${SOCKET_MEM:?Set the selected card EAL memory MiB vector}"
export HUGEPAGE_KB="${HUGEPAGE_KB:?Set the approved hugepage size in KiB}"
export HUGEPAGES_REQUIRED="${HUGEPAGES_REQUIRED:?Set required free local pages}"
export HUGEPAGE_MOUNT="${HUGEPAGE_MOUNT:?Set the matching hugetlbfs mount}"
export EXPECTED_PCIE_GTS=8
export EXPECTED_PCIE_WIDTH=16
export VERSION_LOCK="${VERSION_LOCK:?Set the selected card private mlx5 version-lock JSON}"
export CONFIG_FILE="${CONFIG_FILE:?Set the approved engine configuration}"
export RUN_ID="${RUN_ID:?Set a unique attempt ID}"
export RDMA_CORE_VERSION="${RDMA_CORE_VERSION:?Set the approved rdma-core/provider version}"
export DOCA_VERSION="${DOCA_VERSION:?Set the approved DOCA version or not-used}"

# Check both cards independently with new output paths. A software fixture sets
# BRINGUP_SYSFS_ROOT and command fixtures; that PASS never qualifies hardware.
