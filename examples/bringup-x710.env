# SPDX-License-Identifier: Apache-2.0
# Source this file after private deployment values are set.
# VERSION_LOCK must pin pmd="net_i40e", driver="vfio-pci", and exact observed
# DPDK, firmware, module and kernel versions. These are version-lock fields,
# not additional checker overrides. Use the approved CONFIG_FILE/topology.

export DUT_PCI_PORT0="${DUT_PCI_PORT0:?Set the first X710 PCI function}"
export DUT_PCI_PORT1="${DUT_PCI_PORT1:?Set the second X710 PCI function}"
export DUT_PCI="$DUT_PCI_PORT0"
export DUT_NODE="${DUT_NODE:-1}"
export CORE_SET="${NODE1_CORE_SET:?Set allowed CPU IDs on node1}"
export HUGEPAGE_KB=1048576
export HUGEPAGES_REQUIRED="${HUGEPAGES_REQUIRED:?Set required free 1 GiB pages on node1}"
export HUGEPAGE_MOUNT="${HUGEPAGE_MOUNT:?Set the 1 GiB hugetlbfs mount}"
export SOCKET_MEM="0,${NODE1_MEMORY_MIB:?Set requested node1 memory in MiB}"
export EXPECTED_PCIE_GTS="${EXPECTED_PCIE_GTS:?Set approved negotiated PCIe rate}"
export EXPECTED_PCIE_WIDTH="${EXPECTED_PCIE_WIDTH:?Set approved negotiated PCIe width}"
export VERSION_LOCK="${VERSION_LOCK:?Set the private net_i40e/vfio-pci version-lock JSON}"
export CONFIG_FILE="${CONFIG_FILE:?Set the approved engine configuration}"
export RUN_ID="${RUN_ID:?Set a unique bring-up attempt ID}"

# The checker probes one function per invocation. Select each function and use
# separate new manifest paths; see docs/BRING-UP.md. This file starts no traffic.
