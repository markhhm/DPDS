#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
cd "$(git rev-parse --show-toplevel)"
check=false
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    if [ "$local_oid" != "$(git rev-parse HEAD)" ]; then
        echo "Check out the commit being pushed before running pre-push checks." >&2
        exit 1
    fi
    check=true
done
"$check" || exit 0
if [ -n "$(git status --porcelain)" ]; then
    echo "Commit or stash changes before running pre-push checks." >&2
    exit 1
fi
exec scripts/check.sh
